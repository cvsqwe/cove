# Cove — заставка загрузки в стиле экрана входа (greeter/shell.qml): размытые обои,
# знак Cove в круге акцента и поле пароля-«пилюля». Картинки и цвета рисует system/boot/install.sh.
# Цвета @..@ подставляются при установке (0..1).

W = Window.GetWidth();
H = Window.GetHeight();
X = Window.GetX();
Y = Window.GetY();
Window.SetBackgroundTopColor(@BASE_RGB@);
Window.SetBackgroundBottomColor(@BASE_RGB@);

# ---- фон: обои как у гритера, заполняют экран без искажений ----
bg.image = Image("background.png");
bg.k = W / bg.image.GetWidth();
if (H / bg.image.GetHeight() > bg.k) bg.k = H / bg.image.GetHeight();
bg.w = Math.Int(bg.image.GetWidth() * bg.k + 0.5);
bg.h = Math.Int(bg.image.GetHeight() * bg.k + 0.5);
bg.sprite = Sprite(bg.image.Scale(bg.w, bg.h));
bg.sprite.SetPosition(X + (W - bg.w) / 2, Y + (H - bg.h) / 2, -100);

# ---- знак Cove ----
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = X + W / 2 - logo.image.GetWidth() / 2;
logo.y = Y + H / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# подпись под знаком: выключение, перезагрузка, сообщения
fun text_sprite(str, alpha) {
    local.s = Sprite(Image.Text(str, @DIM_RGB@, alpha, "Adwaita Sans 14"));
    s.SetPosition(X + W / 2 - s.GetImage().GetWidth() / 2, logo.y + logo.image.GetHeight() + 24, 20);
    return s;
}
mode = Plymouth.GetMode();
if (mode == "shutdown") caption = text_sprite("Выключение…", 1);
else if (mode == "reboot") caption = text_sprite("Перезагрузка…", 1);
else if (mode == "updates" || mode == "system-upgrade") caption = text_sprite("Установка обновлений…", 1);

# ---- дыхание знака, пока система грузится ----
t = 0;
fun refresh_callback() {
    global.t++;
    if (global.status == "password") logo.sprite.SetOpacity(1);
    else logo.sprite.SetOpacity(0.8 + 0.2 * Math.Sin(global.t / 22));
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- пароль от диска ----
status = "normal";
fun dialog_setup() {
    local.d;
    d.entry = Sprite(Image("entry.png"));
    d.w = d.entry.GetImage().GetWidth();
    d.h = d.entry.GetImage().GetHeight();
    d.x = X + W / 2 - d.w / 2;
    d.y = logo.y + logo.image.GetHeight() + 28;
    d.entry.SetPosition(d.x, d.y, 30);
    d.hint = Sprite(Image.Text("Пароль от диска", @DIM_RGB@, 1, "Adwaita Sans 14"));
    d.hint.SetPosition(X + W / 2 - d.hint.GetImage().GetWidth() / 2, d.y + d.h / 2 - d.hint.GetImage().GetHeight() / 2, 31);
    d.bullet = Image("bullet.png");
    global.dialog = d;
}

fun dialog_show(o) {
    dialog.entry.SetOpacity(o);
    dialog.hint.SetOpacity(o);
    for (i = 0; global.dots[i]; i++) global.dots[i].SetOpacity(0);
}

fun display_normal_callback() {
    global.status = "normal";
    if (global.dialog) dialog_show(0);
    if (global.caption) caption.SetOpacity(1);
}

fun display_password_callback(prompt, bullets) {
    global.status = "password";
    if (!global.dialog) dialog_setup();
    dialog_show(1);
    if (global.caption) caption.SetOpacity(0);
    n = bullets;
    if (n > 24) n = 24;
    if (n == 0) dialog.hint.SetOpacity(1);
    else dialog.hint.SetOpacity(0);
    # точки по центру поля, как у гритера: 10 px и 8 px между ними
    bw = dialog.bullet.GetWidth();
    x0 = X + W / 2 - (n * bw + (n - 1) * 8) / 2;
    for (i = 0; i < n; i++) {
        if (!global.dots[i]) global.dots[i] = Sprite(dialog.bullet);
        global.dots[i].SetPosition(x0 + i * (bw + 8), dialog.y + dialog.h / 2 - dialog.bullet.GetHeight() / 2, 32);
        global.dots[i].SetOpacity(1);
    }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---- сообщения (проверка диска и т. п.): мелко под знаком ----
fun display_message_callback(text) {
    if (global.status == "password") return;
    global.message = text_sprite(text, 0.8);
}
fun hide_message_callback(text) {
    if (global.message) global.message.SetOpacity(0);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
