/* Cove Code в стиле шелла: тёмный фон ($cove-crust), на нём карточки со скруглёнными рамками,
   сверху капсулы и остров, снизу капсулы. Цвета — из палитры шелла (palette.py). */

Screen {
    background: $cove-crust;
}

/* ---- верхняя панель: ◐ Cove · остров · действия ---- */
#topbar {
    height: 1;
    margin: 0 1;
    background: $cove-crust;
}
#top-spacer-l, #top-spacer-r { width: 1fr; }
#topbar Pill { margin: 0 0 0 1; }
#cove-pill { margin: 0; }

/* ---- тело ---- */
#body {
    height: 1fr;
    margin: 1 1 0 1;
}

/* карточка дерева */
#sidebar {
    width: 32;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $cove-mantle;
    border: round $cove-surface0;
    border-title-color: $cove-subtext0;
    border-title-style: bold;
    scrollbar-size-vertical: 1;
    scrollbar-background: $cove-mantle;
}
#sidebar:focus { border: round $primary 70%; border-title-color: $primary; }
#sidebar > .tree--guides,
#sidebar > .tree--guides-hover,
#sidebar > .tree--guides-selected { color: $cove-mantle; }
#sidebar > .tree--cursor { background: $cove-surface0; color: $foreground; text-style: none; }
#sidebar:focus > .tree--cursor { background: $primary 22%; color: $foreground; text-style: bold; }
#sidebar > .tree--highlight-line { background: $cove-surface0 60%; }
#sidebar > .directory-tree--folder { color: $foreground; text-style: bold; }
#sidebar > .directory-tree--extension { color: $cove-overlay1; }
#sidebar > .directory-tree--hidden { color: $cove-overlay0; }

#switcher { width: 1fr; height: 1fr; }

/* карточка редактора: вкладки-капсулы, поиск, поле */
#editor-card {
    background: $background;
    border: round $cove-surface0;
    border-title-color: $cove-overlay1;
    padding: 0;
}
#editor-card:focus-within { border: round $primary 60%; border-title-color: $cove-subtext0; }
#tabstrip {
    height: 1;
    margin: 0 1 1 1;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}
#tabstrip TabPill { margin: 0 1 0 0; }
#editors { height: 1fr; }

CoveTextArea {
    border: none;
    padding: 0 1 0 0;
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-background: $background;
}
CoveTextArea:focus { border: none; }

/* ---- поиск: две компактные строки над текстом ---- */
#findbar {
    height: auto;
    margin: 0 1 1 1;
    padding: 0 1;
    background: $cove-mantle;
}
.find-row { height: 1; }
.find-icon { width: 3; color: $primary; }
.find-row Input { width: 1fr; background: $cove-mantle; color: $foreground; }
.find-row Input:focus { background: $cove-surface0; }
#find-count { width: 12; content-align: center middle; color: $cove-overlay1; }
Button.small {
    min-width: 3;
    width: auto;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    background: $cove-surface0;
    color: $foreground;
}
Button.small:hover { background: $cove-surface1; }

/* ---- строка состояния: путь слева, капсулы справа ---- */
#statusbar {
    height: 1;
    margin: 1 1 0 1;
    background: $cove-crust;
}
#st-path { padding: 0 1; }
#st-spacer { width: 1fr; }
#statusbar Pill { margin: 0 0 0 1; }

/* ---- стартовый экран как лаунчер ---- */
#dashboard {
    background: $background;
    border: round $cove-surface0;
    align: center middle;
    padding: 1 0;
}
#logo { color: $primary; width: auto; margin: 0 0 1 0; }
#dash-hello { width: auto; color: $foreground; }
#dash-project { width: auto; color: $cove-overlay1; margin: 0 0 1 0; }
#dash-box {
    width: 72;
    height: auto;
    background: $cove-mantle;
    border: round $cove-surface1;
    padding: 0 1;
}
#dash-box:focus-within { border: round $primary; }
#dash-search { background: $cove-mantle; margin: 0 0 1 0; }
#dash-list {
    height: auto;
    max-height: 10;
    border: none;
    background: $cove-mantle;
    padding: 0;
}
#dash-list > .option-list--option-highlighted { background: $primary 22%; color: $foreground; }
#dash-list > .option-list--option-hover { background: $cove-surface0; }
#dash-buttons { width: auto; height: 1; margin: 1 0 0 0; }
#dash-buttons Pill { margin: 0 1; }

/* ---- диалоги ---- */
.dialog-screen {
    align: center top;
    background: $cove-crust 60%;
}
.dialog {
    width: 64;
    height: auto;
    margin: 4 0 0 0;
    padding: 1 2;
    background: $cove-mantle;
    border: round $primary;
}
.dialog.quick { width: 80; }
.dialog-title { text-style: bold; color: $primary; margin: 0 0 1 0; }
.dialog-text { color: $foreground; margin: 0 0 1 0; }
.dialog Input { border: tall $cove-surface0; background: $background; }
.dialog Input:focus { border: tall $primary; }
.dialog .buttons { height: auto; align: right middle; margin: 1 0 0 0; }
.dialog Button { margin: 0 0 0 1; border: none; height: 3; background: $cove-surface0; }
.dialog Button:hover { background: $cove-surface1; }
.dialog Button.-primary { background: $primary; color: $cove-crust; text-style: bold; }
.dialog Button.-error { background: $error 25%; color: $error; }
#results {
    height: auto;
    max-height: 20;
    border: none;
    background: transparent;
    margin: 1 0 0 0;
}
#results > .option-list--option-highlighted { background: $primary 25%; color: $foreground; }

/* ---- всплывающее меню ---- */
.popup-screen { background: transparent; }
#popup {
    height: auto;
    max-height: 24;
    background: $cove-mantle;
    border: round $cove-surface1;
    padding: 0;
}
#popup > .option-list--option-highlighted { background: $primary 25%; color: $foreground; }
#popup > .option-list--option-hover { background: $cove-surface0; }
#popup > .option-list--separator { color: $cove-surface1; }

Toast {
    background: $cove-mantle;
    border-left: outer $primary;
}
