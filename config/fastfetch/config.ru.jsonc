// Полный fastfetch Cove (ru), команда ff. Собран tools/fastfetch/build.py, правки вносить туда
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/cove/branding/logo.txt",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "output": "default"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": null,
      "width": 12,
      "color": {
        "total": "90"
      }
    },
    "percent": {
      "type": [
        "bar"
      ],
      "color": {
        "green": "magenta",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;magenta}{user-name}{#} {#90}·{#} {#blue}{host-name}{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}╭─{#} {#1;magenta}система{#}"
    },
    {
      "type": "os",
      "key": "{#90}│{#} {#blue}󰣇{#}  {#magenta}ос        {#}",
      "format": "Cove · {name}"
    },
    {
      "type": "kernel",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}ядро      {#}",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "{#90}│{#} {#blue}󰅐{#}  {#magenta}в сети    {#}",
      "format": "{?days}{days} д {?}{?hours}{hours} ч {?}{minutes} мин"
    },
    {
      "type": "packages",
      "key": "{#90}│{#} {#blue}󰏖{#}  {#magenta}пакеты    {#}",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "{#90}├─{#} {#1;magenta}окружение{#}"
    },
    {
      "type": "wm",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}оконный   {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}оболочка  {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}терминал  {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}шрифт     {#}",
      "format": "{name} {size}"
    },
    {
      "type": "custom",
      "format": "{#90}├─{#} {#1;magenta}железо{#}"
    },
    {
      "type": "cpu",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}процессор {#}",
      "format": "{name} · {cores-logical} потоков"
    },
    {
      "type": "gpu",
      "key": "{#90}│{#} {#blue}󰢮{#}  {#magenta}видео     {#}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#90}│{#} {#blue}󰍛{#}  {#magenta}память    {#}",
      "format": "{percentage-bar} {used} из {total}"
    },
    {
      "type": "disk",
      "key": "{#90}│{#} {#blue}󰋊{#}  {#magenta}диск      {#}",
      "folders": "/",
      "format": "{size-percentage-bar} {size-used} из {size-total}"
    },
    {
      "type": "display",
      "key": "{#90}│{#} {#blue}󰍹{#}  {#magenta}экран     {#}",
      "format": "{width}×{height} · {refresh-rate} Гц"
    },
    {
      "type": "custom",
      "format": "{#90}╰─{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "   {#35}● {#34}● {#36}● {#32}● {#33}● {#31}● {#90}●{#}"
    }
  ]
}
