// Полный fastfetch Cove (abbr ff)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/cove/branding/logo.txt",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "magenta",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[2mcove · своя экосистема на Hyprland\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "система   ",
      "format": "Cove · {pretty-name}"
    },
    {
      "type": "kernel",
      "key": "ядро      "
    },
    {
      "type": "wm",
      "key": "оболочка  "
    },
    {
      "type": "shell",
      "key": "терминал  "
    },
    {
      "type": "terminal",
      "key": "эмулятор  "
    },
    {
      "type": "uptime",
      "key": "в работе  "
    },
    {
      "type": "packages",
      "key": "пакеты    "
    },
    "break",
    {
      "type": "cpu",
      "key": "процессор "
    },
    {
      "type": "gpu",
      "key": "видеокарта"
    },
    {
      "type": "memory",
      "key": "память    "
    },
    {
      "type": "disk",
      "key": "диск      ",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "экран     "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
