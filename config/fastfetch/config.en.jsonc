// Полный fastfetch Cove (en), команда ff. Собран tools/fastfetch/build.py, правки вносить туда
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/cove/branding/logo.txt",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "output": "default"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": null,
      "width": 12,
      "color": {
        "total": "90"
      }
    },
    "percent": {
      "type": [
        "bar"
      ],
      "color": {
        "green": "magenta",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;magenta}{user-name}{#} {#90}·{#} {#blue}{host-name}{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}╭─{#} {#1;magenta}system{#}"
    },
    {
      "type": "os",
      "key": "{#90}│{#} {#blue}󰣇{#}  {#magenta}os        {#}",
      "format": "Cove · {name}"
    },
    {
      "type": "kernel",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}kernel    {#}",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "{#90}│{#} {#blue}󰅐{#}  {#magenta}uptime    {#}",
      "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m"
    },
    {
      "type": "packages",
      "key": "{#90}│{#} {#blue}󰏖{#}  {#magenta}packages  {#}",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "{#90}├─{#} {#1;magenta}desktop{#}"
    },
    {
      "type": "wm",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}wm        {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}shell     {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}terminal  {#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}font      {#}",
      "format": "{name} {size}"
    },
    {
      "type": "custom",
      "format": "{#90}├─{#} {#1;magenta}hardware{#}"
    },
    {
      "type": "cpu",
      "key": "{#90}│{#} {#blue}{#}  {#magenta}cpu       {#}",
      "format": "{name} · {cores-logical} threads"
    },
    {
      "type": "gpu",
      "key": "{#90}│{#} {#blue}󰢮{#}  {#magenta}gpu       {#}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#90}│{#} {#blue}󰍛{#}  {#magenta}memory    {#}",
      "format": "{percentage-bar} {used} of {total}"
    },
    {
      "type": "disk",
      "key": "{#90}│{#} {#blue}󰋊{#}  {#magenta}disk      {#}",
      "folders": "/",
      "format": "{size-percentage-bar} {size-used} of {size-total}"
    },
    {
      "type": "display",
      "key": "{#90}│{#} {#blue}󰍹{#}  {#magenta}display   {#}",
      "format": "{width}×{height} · {refresh-rate} Hz"
    },
    {
      "type": "custom",
      "format": "{#90}╰─{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "   {#35}● {#34}● {#36}● {#32}● {#33}● {#31}● {#90}●{#}"
    }
  ]
}
