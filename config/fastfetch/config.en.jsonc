// Full Cove fastfetch (ff)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/cove/branding/logo.txt",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "top": 2,
      "right": 5,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "magenta",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[2mcove · your own ecosystem on Hyprland\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "key": "system    ",
      "format": "Cove · {pretty-name}"
    },
    {
      "type": "kernel",
      "key": "kernel    "
    },
    {
      "type": "wm",
      "key": "wm        "
    },
    {
      "type": "shell",
      "key": "shell     "
    },
    {
      "type": "terminal",
      "key": "terminal  "
    },
    {
      "type": "uptime",
      "key": "uptime    "
    },
    {
      "type": "packages",
      "key": "packages  "
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu       "
    },
    {
      "type": "gpu",
      "key": "gpu       "
    },
    {
      "type": "memory",
      "key": "memory    "
    },
    {
      "type": "disk",
      "key": "disk      ",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "display   "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
