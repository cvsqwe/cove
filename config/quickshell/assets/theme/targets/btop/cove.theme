# Cove: сгенерировано движком тем (assets/theme/targets/btop) — правки затрутся
theme[main_bg]="{{base}}"
theme[main_fg]="{{text}}"
theme[title]="{{text}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{surface1}}"
theme[selected_fg]="{{accent}}"
theme[inactive_fg]="{{overlay0}}"
theme[graph_text]="{{subtext0}}"
theme[meter_bg]="{{surface1}}"
theme[proc_misc]="{{accent2}}"
theme[cpu_box]="{{accent}}"
theme[mem_box]="{{green}}"
theme[net_box]="{{accent2}}"
theme[proc_box]="{{teal}}"
theme[div_line]="{{surface1}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"
theme[cpu_start]="{{accent}}"
theme[cpu_mid]="{{accent|mix:accent2:0.5}}"
theme[cpu_end]="{{accent2}}"
theme[free_start]="{{green|darken:0.3}}"
theme[free_mid]="{{green|darken:0.15}}"
theme[free_end]="{{green}}"
theme[cached_start]="{{teal|darken:0.3}}"
theme[cached_mid]="{{teal|darken:0.15}}"
theme[cached_end]="{{teal}}"
theme[available_start]="{{yellow|darken:0.3}}"
theme[available_mid]="{{yellow|darken:0.15}}"
theme[available_end]="{{yellow}}"
theme[used_start]="{{red|darken:0.3}}"
theme[used_mid]="{{red|darken:0.15}}"
theme[used_end]="{{red}}"
theme[download_start]="{{accent|darken:0.3}}"
theme[download_mid]="{{accent|darken:0.15}}"
theme[download_end]="{{accent}}"
theme[upload_start]="{{accent2|darken:0.3}}"
theme[upload_mid]="{{accent2|darken:0.15}}"
theme[upload_end]="{{accent2}}"
theme[process_start]="{{accent}}"
theme[process_mid]="{{accent|mix:accent2:0.5}}"
theme[process_end]="{{accent2}}"
