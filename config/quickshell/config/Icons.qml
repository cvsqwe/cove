    // имя Material Symbols для значка или "" — рисовать как есть
    function name(s: string): string {
        if (!s) return "";
        if (/^[a-z0-9_]+$/.test(s)) return s;
        const cp = s.codePointAt(0);
        if (s.length > (cp > 0xFFFF ? 2 : 1)) return "";
        return map[cp.toString(16).toUpperCase()] ?? "";
    }
