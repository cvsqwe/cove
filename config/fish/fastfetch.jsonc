// Компактный fastfetch со знаком Cove (~/.config/cove/branding/logo.txt) для приветствия fish (полный — просто `ff`)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "file", "source": "~/.config/cove/branding/logo.txt", "color": { "1": "magenta", "2": "blue" }, "padding": { "top": 1, "right": 4 } },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta" },
        "key": { "width": 4 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "user": "magenta", "host": "blue" } },
        { "type": "os", "key": "󰞍", "format": "Cove · {pretty-name}" },
        { "type": "kernel", "key": "\uf013" },
        { "type": "wm", "key": "\uf2d2" },
        { "type": "uptime", "key": "󰅐" },
        { "type": "packages", "key": "󰏖" },
        { "type": "memory", "key": "󰍛" },
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
