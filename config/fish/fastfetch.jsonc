// Компактный fastfetch Cove для приветствия fish. Собран tools/fastfetch/build.py, правки вносить туда
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/cove/branding/logo-small.txt",
    "color": {
      "1": "magenta",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "output": "default"
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": null,
      "width": 12,
      "color": {
        "total": "90"
      }
    },
    "percent": {
      "type": [
        "bar"
      ],
      "color": {
        "green": "magenta",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;magenta}{user-name}{#} {#90}·{#} {#blue}{host-name}{#}"
    },
    {
      "type": "os",
      "key": "{#90}╭{#} {#blue}󰣇{#}",
      "format": "Cove · {name}"
    },
    {
      "type": "wm",
      "key": "{#90}│{#} {#blue}{#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "uptime",
      "key": "{#90}│{#} {#blue}󰅐{#}",
      "format": "{?days}{days} д {?}{?hours}{hours} ч {?}{minutes} мин"
    },
    {
      "type": "memory",
      "key": "{#90}│{#} {#blue}󰍛{#}",
      "format": "{percentage-bar} {used} из {total}"
    },
    {
      "type": "custom",
      "format": "{#90}╰{#} {#35}● {#34}● {#36}● {#32}● {#33}● {#31}● {#90}●{#}"
    }
  ]
}
